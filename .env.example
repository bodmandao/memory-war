# ── Chain (required) ────────────────────────────────────────────────
# Local devnet (default; works with no setup: `npm run chain:node`)
CHAIN_RPC_URL=http://127.0.0.1:8545
# 0G testnet (Galileo): https://docs.0g.ai/developer-hub/testnet/testnet-overview
# CHAIN_RPC_URL=https://evmrpc-testnet.0g.ai
# 0G mainnet (real value — verify against docs.0g.ai before using):
# CHAIN_RPC_URL=https://evmrpc.0g.ai
CHAIN_PRIVATE_KEY=
# Optional, second wallet — used only for the "investigatorB" role in
# demo/lib.ts, so a two-investigator flow (Scenario B/C) can produce a
# genuinely distinct second investigator address instead of the shared
# wallet above submitting a second report on the same challenge (which
# the contract's own DuplicateReport protection correctly rejects).
# Falls back to CHAIN_PRIVATE_KEY when unset.
INVESTIGATOR_B_PRIVATE_KEY=
MEMORY_WAR_CONTRACT_ADDRESS=
# Portable investigator identity registry (see contracts/InvestigatorRegistry.sol
# and docs/ERC7857_DECISION.md) — printed by chain:deploy:local alongside the
# main contract address. Optional: submitReport() (address-only) still works
# without it; submitReportAsIdentity() and Scenario C require it.
INVESTIGATOR_REGISTRY_ADDRESS=

# ── 0G Storage (optional — auto-fallback to a local demo mode) ───────
# If unset, or if @0gfoundation/0g-storage-ts-sdk cannot reach the network,
# the storage adapter runs in LOCAL mode: real content-hashing and real
# tamper detection, against a local content-addressed store instead of the
# live 0G Storage network. It is labeled LOCAL DEMO everywhere it is used.
# Testnet indexer (default below) or mainnet: https://indexer-storage-turbo.0g.ai
# — storage uses CHAIN_RPC_URL/CHAIN_PRIVATE_KEY above as its underlying
# chain wallet, so point CHAIN_RPC_URL at whichever network this indexer
# is on.
OG_STORAGE_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
OG_STORAGE_MODE=auto
# auto | live | local

# ── 0G Compute (optional — auto-fallback to a local investigator) ───
# If unset, the compute adapter falls back to a local investigator.
# With ANTHROPIC_API_KEY/OPENAI_API_KEY set, that fallback is a real LLM
# call labeled LOCAL_LLM (not TEE-attested). With neither set, it falls
# back further to a deterministic rule-based stub labeled SIMULATED.
# Live mode requires a funded 0G ledger and is labeled 0G_COMPUTE_TEE.
#
# Compute has its OWN network/wallet, deliberately separate from
# CHAIN_RPC_URL/CHAIN_PRIVATE_KEY above — 0G Compute is not documented
# as available on 0G mainnet, so keeping it on its own testnet key means
# a mainnet deployment wallet can never be reused for compute by
# accident. Falls back to CHAIN_RPC_URL/CHAIN_PRIVATE_KEY only if these
# aren't set.
OG_COMPUTE_CHAIN_RPC_URL=https://evmrpc-testnet.0g.ai
COMPUTE_PRIVATE_KEY=
OG_COMPUTE_MODE=auto
# auto | live | local
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Indexer (optional — defaults shown) ──────────────────────────────
INDEXER_PORT=4400
INDEXER_DB_PATH=./.data/indexer.json

# ── Demo / agent driver (optional — defaults shown) ──────────────────
# /run/* and /agent/verify-claim spend real funds from CHAIN_PRIVATE_KEY.
# If DEMO_API_KEY is set, those routes require a matching X-Demo-Key
# header; if unset (the local-devnet default), auth is skipped entirely.
# Set this before deploying demo/server.ts anywhere public.
DEMO_SERVER_PORT=4401
DEMO_API_KEY=

# ── Client (optional — defaults shown, only needed if apps/client is
#    served from somewhere other than the same machine as the indexer
#    and demo driver) ──────────────────────────────────────────────
NEXT_PUBLIC_INDEXER_URL=http://localhost:4400
# The client never talks to the demo server directly — app/api/demo/[...path]/route.ts
# proxies it server-side and attaches DEMO_API_KEY, so neither the demo
# server's real URL nor the key is ever visible to the browser.
DEMO_UPSTREAM_URL=http://localhost:4401
# Must match DEMO_API_KEY above exactly when both server and client are
# deployed separately — this is the client's copy of the same secret,
# kept server-side only (no NEXT_PUBLIC_ prefix).
DEMO_API_KEY=
